<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lunar_illuminator</name>
  <version>0.1.0</version>
  <description>Drives a simulator's sun light from the lunar sky tracker's az/el</description>
  <maintainer email="jasmeet0915@gmail.com">Jasmeet Singh</maintainer>
  <license>Apache-2.0</license>
  <author email="jasmeet0915@gmail.com">Jasmeet Singh</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>artemis_mission_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>gz_transport_vendor</depend>
  <depend>gz_msgs_vendor</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
