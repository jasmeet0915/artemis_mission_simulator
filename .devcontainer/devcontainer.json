{
  "name": "Artemis Mission Simulator (ROS 2)",
  "build": {
    "dockerfile": "../docker/Dockerfile",
    "context": "../docker"
  },
  "remoteUser": "commander",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/commander/src,type=bind",
  "workspaceFolder": "/home/commander/src",
  "updateRemoteUserUID": true,
  // Run xhost on the host so the container can connect to the X server.
  "initializeCommand": "xhost +local:docker > /dev/null 2>&1 || true",
  "runArgs": [
    "--name=artemis-sim-devcontainer",
    "--hostname=artemis",
    "--network=host",
    "-e", "QT_X11_NO_MITSHM=1",
    "-e", "WORKSPACE_DIR=/home/commander"
    // ,"--gpus=all"
    // ,"-e", "NVIDIA_VISIBLE_DEVICES=all"
    // ,"-e", "NVIDIA_DRIVER_CAPABILITIES=all"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=artemis-build,target=/home/commander/build,type=volume",
    "source=artemis-install,target=/home/commander/install,type=volume",
    "source=artemis-log,target=/home/commander/log,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.flake8",
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-xml",
        "redhat.vscode-yaml",
        "eamodio.gitlens",
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.cwd": "/home/commander"
      }
    }
  }
}
