<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lunar_sky_tracker</name>
  <version>0.1.0</version>
  <description>Package to track position (azimuth, elevation) of celestial objects in lunar sky</description>
  <maintainer email="jasmeet0915@gmail.com">Jasmeet Singh</maintainer>
  <license>Apache-2.0</license>
  <author email="jasmeet0915@gmail.com">Jasmeet Singh</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
